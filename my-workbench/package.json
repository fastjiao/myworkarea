{
  "name": "jiaogt",
  "version": "3.6.8",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --x64",
    "pack": "electron-builder build --win --x64 --dir"
  },
  "build": {
    "appId": "com.jiaogongtai.workbench",
    "productName": "教公台",
    "directories": {
      "output": "../jiao-release"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "教公台"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "netease-api-host.js",
      "block-external-protocol-preload.js",
      "index.html",
      "styles.css",
      "modules/**/*",
      "data/**/*"
    ],
    "extraResources": [
      {
        "from": "data/",
        "to": "data/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true
  },
  "keywords": [
    "electron",
    "workbench",
    "dashboard",
    "launcher"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "NeteaseCloudMusicApi": "^4.32.0",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  }
}
